# ============================================================
# Civic-Connect Environment Configuration & Secret Template
# ============================================================
# Copy this file to '.env' and customize values as needed.
# DO NOT commit your actual '.env' file containing real secrets to GitHub!

# Geocoding & Map Service Configuration
# Nominatim policy requires a unique user-agent identifying your application
NOMINATIM_USER_AGENT=Civic-Connect/1.0

# Optional API keys for third-party map or geocoding services (e.g. Mapbox, OpenCage, Google Maps)
MAPS_API_KEY=

# Default Map Center Location (Latitude, Longitude)
# Default is Bengaluru (12.9716, 77.5946)
DEFAULT_LATITUDE=12.9716
DEFAULT_LONGITUDE=77.5946

# Municipal Complaint Handling
# Pre-fills the authority email input field in the reporting form
DEFAULT_AUTHORITY_EMAIL=complaints@bbmp.gov.in

# Application Settings
# Timezone for local date and time (default: Asia/Kolkata for IST)
APP_TIMEZONE=Asia/Kolkata

# Maximum photo upload size in MB (default: 10)
MAX_UPLOAD_SIZE_MB=10

